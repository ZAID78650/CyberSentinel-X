# ============================================================
# CyberSentinel X — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Database -------------------------------------------------
# Local development (SQLite — zero setup):
# DATABASE_URL=sqlite:///./data/cybersentinel.db
# Docker / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg2://cybersentinel:cybersentinel@postgres:5432/cybersentinel

# --- Authentication -------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_REFRESH_SECRET=change-me-generate-another-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider ---------------------------------------------
# One of: local | openai | gemini
# local = deterministic rule-based summaries, works with no API key.
LLM_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Vector store ----------------------------------------------
# One of: local (numpy, default) | chroma
VECTOR_DB_BACKEND=local
VECTOR_DB_PATH=./data/vector_store

# --- CORS -------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- URLs -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- App --------------------------------------------------------
APP_NAME=CyberSentinel X
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_SCAN_SKIP=false
