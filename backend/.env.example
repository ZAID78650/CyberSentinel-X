# Local development (SQLite — zero setup). Copy to backend/.env.
DATABASE_URL=sqlite:///../data/cybersentinel.db

JWT_SECRET=dev-local-secret-change-me
JWT_REFRESH_SECRET=dev-local-refresh-secret-change-me

LLM_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=

VECTOR_DB_BACKEND=local
VECTOR_DB_PATH=../data/vector_store

# Social login (optional — leave empty to show SSO buttons as unconfigured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP email (Gmail example — use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fs22ai006@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=CyberSentinel X <fs22ai006@gmail.com>
OPS_EMAIL=fs22ai006@gmail.com

# Docker Hub registry (used by scripts/push-dockerhub.sh)
DOCKER_REGISTRY=fs22ai006/cybersentinel-x

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
