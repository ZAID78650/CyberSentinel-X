# CyberSentinel X — nginx reverse proxy
# ${BACKEND_URL} is substituted at container start by the entrypoint.
# All nginx variables ($uri, $proxy_host, etc.) are safe.

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1024g;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    proxy_ssl_server_name on;

    # Frontend health check — returns 200 if nginx is serving.
    # Render pings this to detect spin-down on free tier.
    location = /healthz {
        access_log off;
        return 200 '{"status":"ok","service":"cybersentinel-frontend"}';
        add_header Content-Type application/json;
    }

    # API proxy — forwards /api/* as-is to the backend (backend mounts routes under /api/)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    # Backend health proxy
    location = /health {
        proxy_pass ${BACKEND_URL}/health;
    }
    location = /ready {
        proxy_pass ${BACKEND_URL}/ready;
    }

    # WebSocket proxy
    location /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Static assets with content hash — cache forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # HTML/JS — no cache to prevent stale chunk issues
    location ~* \.(?:js|css|html|json)$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
}
