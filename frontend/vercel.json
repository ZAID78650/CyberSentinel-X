{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cybersentinel-backend-t5pv.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://cybersentinel-backend-t5pv.onrender.com/ws/:path*"
    },
    {
      "source": "/health",
      "destination": "https://cybersentinel-backend-t5pv.onrender.com/health"
    },
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
